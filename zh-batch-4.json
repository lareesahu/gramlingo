ast tense.", "zh": "选项 D。", "q_text": "Want + to-infinitive.", "answer": "to become", "options": ["become", "to become", "becoming", "became"]}, {"phase": 70, "question": 0, "option": 0, "en": "Smoke = base form.", "zh": "选项 A。", "q_text": "Stop + gerund = quit the activity.", "answer": "smoking", "options": ["smoke", "to smoke", "smoking", "smoked"]}, {"phase": 70, "question": 0, "option": 1, "en": "To smoke = purpose (I stopped to smoke = I stopped in order to smoke).", "zh": "选项 B。", "q_text": "Stop + gerund = quit the activity.", "answer": "smoking", "options": ["smoke", "to smoke", "smoking", "smoked"]}, {"phase": 70, "question": 0, "option": 3, "en": "Smoked = past tense.", "zh": "选项 D。", "q_text": "Stop + gerund = quit the activity.", "answer": "smoking", "options": ["smoke", "to smoke", "smoking", "smoked"]}, {"phase": 70, "question": 1, "option": 0, "en": "Lock = base form.", "zh": "选项 A。", "q_text": "Remember + to-infinitive = not forget to do.", "answer": "to lock", "options": ["lock", "to lock", "locking", "locked"]}, {"phase": 70, "question": 1, "option": 2, "en": "Locking = remember the past action of locking.", "zh": "选项 C。", "q_text": "Remember + to-infinitive = not forget to do.", "answer": "to lock", "options": ["lock", "to lock", "locking", "locked"]}, {"phase": 70, "question": 1, "option": 3, "en": "Locked = past tense.", "zh": "选项 D。", "q_text": "Remember + to-infinitive = not forget to do.", "answer": "to lock", "options": ["lock", "to lock", "locking", "locked"]}, {"phase": 70, "question": 2, "option": 0, "en": "Lift = base form.", "zh": "选项 A。", "q_text": "Try + to-infinitive = attempt something difficult.", "answer": "to lift", "options": ["lift", "to lift", "lifting", "lifted"]}, {"phase": 70, "question": 2, "option": 2, "en": "Lifting = try as experiment (try lifting with your knees).", "zh": "选项 C。", "q_text": "Try + to-infinitive = attempt something difficult.", "answer": "to lift", "options": ["lift", "to lift", "lifting", "lifted"]}, {